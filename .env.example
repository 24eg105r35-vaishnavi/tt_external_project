# Example Environment Configuration for Student Achievement Portal
# Copy this file to .env before starting Docker Compose: cp .env.example .env

# MySQL Database Settings
DB_NAME=achievement_portal
DB_USER=portal_user
DB_PASSWORD=your_secure_db_password
DB_ROOT_PASSWORD=your_secure_root_password

# Application Settings
UPLOAD_DIR=/app/uploads
APP_BASE_URL=http://localhost:8080

# Seeded Accounts Default Passwords (change these after first login!)
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password
FACULTY_DEFAULT_PASSWORD=your_secure_faculty_password
